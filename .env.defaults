# .env.defaults -- template describing the local environment structure.
#
# Copy the keys you need into a gitignored .env.local and put REAL values
# there. This file is committed, so it holds only variable names, safe public
# defaults, and guidance -- never secret values.

# --- OpenAI / LiteLLM gateway ---
# Real OpenAI key (used directly, or proxied through the LiteLLM gateway).
OPENAI_API_KEY=
# LiteLLM gateway base URL (local gateway default shown).
LITELLM_BASE_URL=http://localhost:4000
# LiteLLM gateway auth keys.
LITELLM_MASTER_KEY=
LITELLM_SECRET_KEY=

# --- ngrok (optional tunnel) ---
NGROK_AUTHTOKEN=

# --- Daytona ---
# Required by every GYMSIEGE entrypoint (common.require_env checks this).
# Get it from the Daytona dashboard; left blank on purpose.
DAYTONA_API_KEY=
# Optional; defaults to https://app.daytona.io/api if left blank.
DAYTONA_API_URL=
# Not read by any code here (DAYTONA_API_KEY alone scopes SDK calls); recorded
# for reference (direct API calls, dashboard links).
DAYTONA_ORGANIZATION_ID=

# --- Modal ---
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# --- Langfuse (CI/CD experiment gate) ---
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
# Cloud region or self-hosted base URL.
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# --- Hugging Face ---
# CyberGym's HF dataset (sunblaze-ucb/cybergym-e2e) is gated; snapshot_build.py
# requires the gymsiege-huggingface Daytona vault secret before baking. Fill in
# your token, then run once:
#   .venv/bin/python configure_secrets.py huggingface
HF_TOKEN=

# --- Google Gemini ---
# Standard env var for the Gemini API (generativelanguage.googleapis.com).
GEMINI_API_KEY=

# --- Daytona vault Secret NAMES (non-secret; the values live in the vault) ---
# The Secret values themselves are never stored in this file or committed.
GYMSIEGE_OPENAI_SECRET_NAME=gymsiege-openai
GYMSIEGE_LITELLM_SECRET_NAME=gymsiege-litellm
GYMSIEGE_HF_SECRET_NAME=gymsiege-huggingface
