.env
.env.local
.venv/

# Local LiteLLM gateway stack: docker-compose.yml holds the real
# LITELLM_MASTER_KEY/LITELLM_SALT_KEY/DB password once configured.
litellm-gateway/
# Personal convenience wrapper hardcoding this machine's absolute path to
# the directory above -- not portable project tooling like demo.sh.
start-litellm-gateway.sh
__pycache__/
*.pyc

data/
artifacts/
recordings/*
!recordings/.gitkeep
results/*.json
# Nested run output too: common.py writes per-sandbox telemetry to
# results/telemetry/, which `results/*.json` does not reach.
results/**/*.json
# Event-log telemetry (e.g. results/events.ndjson) isn't caught by the
# *.json patterns above -- same "local-only" treatment as everything else
# under results/ except the one tracked schema template.
results/*.ndjson
results/**/*.ndjson
!results/.gitkeep
# Gated CyberGym-E2E crash logs used to regenerate the derived task index.
results/cybergym_index/
# Honeypot run output: per-run events.tsv/report.json/pids, the shim dir, and
# the compiled libagent_honeypot.so -- all reproducible by re-running the
# harness, so never tracked.
results/agent-honeypot/
results/agent-honeypot-corpus/
# Modal honeypot run output (smoke/full run dirs): summary/modal-run JSON and
# logs are already ignored above, but the artifacts.tar.gz bundles are binary
# and must never enter history. Reproducible by re-running modal_honeypot.
results/modal-honeypot*/
# CVE-Bench run output: Inspect .eval logs and console transcripts from
# CVE-bench/run_cvebench.py -- local-only, reproducible by re-running.
results/cve-bench/
# Network-off containment suite run output -- same local-only, reproducible
# treatment as the other modal_honeypot run dirs above.
results/modal-network-off/
snapshot_build.metrics.json
*.log

# keep the honest schema template, ignore live run output
!results/exploitgym-runs/
!results/exploitgym-runs/results.json

# personal resume/interview notes, not project documentation
interview-bullets.md

# ad-hoc agent handoff notes, not project documentation
codex-handoff-*.md

# Agent CLI skills installed by `hf skills add --claude`. Not committed for
# two reasons: the content is auto-generated from a pinned huggingface_hub
# version, so `hf skills add --force` reproduces it exactly; and the
# .claude/skills entry is a WSL symlink into .agents/ that Windows git cannot
# traverse ("Function not implemented") and that would degrade to a plain text
# file on a Windows checkout.
.agents/
.claude/skills/
